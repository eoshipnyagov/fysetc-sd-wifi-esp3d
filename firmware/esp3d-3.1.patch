+static volatile uint32_t fysetcPrinterBusyUntil = 0;
+static void IRAM_ATTR fysetcPrinterCSFalling() {
+  if (!ESP_SD::isEnabled()) fysetcPrinterBusyUntil = millis() + 20000UL;
+}
+
+void fysetcInitializeSharedSD() {
+  pinMode(ESP_SD_CS_SENSE, INPUT);
+  fysetcPrinterBusyUntil = millis() + 20000UL;
+  attachInterrupt(digitalPinToInterrupt(ESP_SD_CS_SENSE),
+                  fysetcPrinterCSFalling, FALLING);
+}
+
+static bool fysetcIsManagedMarker(const String& name) {
+  String upper = name;
+  upper.toUpperCase();
+  if (upper.startsWith("PW_") && upper.endsWith(".GCO") &&
+      upper.length() > 7) {
+    return true;
+  }
+  if ((!upper.startsWith("IP_") && !upper.startsWith("AP_")) ||
+      !upper.endsWith(".GCO")) {
+    return false;
+  }
+  uint8_t octets = 1;
+  uint8_t digits = 0;
+  uint16_t value = 0;
+  for (size_t i = 3; i < upper.length() - 4; ++i) {
+    const char c = upper[i];
+    if (c == '.') {
+      if (digits == 0 || value > 255 || octets == 4) return false;
+      ++octets;
+      digits = 0;
+      value = 0;
+    } else if (c >= '0' && c <= '9') {
+      ++digits;
+      value = value * 10 + c - '0';
+      if (digits > 3 || value > 255) return false;
+    } else {
+      return false;
+    }
+  }
+  return octets == 4 && digits != 0 && value <= 255;
+}
+
+static String fysetcPasswordMarker(const String& password) {
+  static const char hex[] = "0123456789ABCDEF";
+  String name = "PW_";
+  for (size_t i = 0; i < password.length(); ++i) {
+    const uint8_t c = static_cast<uint8_t>(password[i]);
+    if ((c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') ||
+        (c >= '0' && c <= '9') || c == '_' || c == '-') {
+      name += static_cast<char>(c);
+    } else {
+      name += '~';
+      name += hex[c >> 4];
+      name += hex[c & 0x0F];
+    }
+  }
+  name += ".GCO";
+  return name;
+}
+
+static bool fysetcEnsureEmptyMarker(const String& name) {
+  if (name.length() == 0) return true;
+  const String path = String("/") + name;
+  if (ESP_SD::exists(path.c_str())) {
+    ESP_SDFile existing = ESP_SD::open(path.c_str(), ESP_FILE_READ);
+    const bool valid = existing.isOpen() && existing.size() == 0;
+    existing.close();
+    return valid;
+  }
+  ESP_SDFile created = ESP_SD::open(path.c_str(), ESP_FILE_WRITE);
+  const bool valid = created.isOpen();
+  created.close();
+  return valid;
+}
+
+static void fysetcUpdateIPMarker() {
+  static uint32_t nextAttempt = 0;
+  static String appliedMarker;
+  static String appliedPasswordMarker;
+  if (static_cast<int32_t>(millis() - nextAttempt) < 0) return;
+  nextAttempt = millis() + 1000UL;
+
+  const auto mode = WiFi.getMode();
+  IPAddress ip;
+  if (mode == WIFI_STA && WiFi.isConnected()) {
+    ip = WiFi.localIP();
+  } else if (mode == WIFI_AP) {
+    ip = WiFi.softAPIP();
+  } else {
+    return;
+  }
+  if (static_cast<uint32_t>(ip) == 0) return;
+  const String marker = String(mode == WIFI_AP ? "AP_" : "IP_") +
+                        ip.toString() + ".GCO";
+  const String password = mode == WIFI_AP
+                              ? ESP3DSettings::readString(ESP_AP_PASSWORD)
+                              : String();
+  const String passwordMarker = password.length() > 0
+                                    ? fysetcPasswordMarker(password)
+                                    : String();
+  if (marker == appliedMarker && passwordMarker == appliedPasswordMarker) return;
+  if (!ESP_SD::accessFS()) {
+    nextAttempt = millis() + 5000UL;
+    return;
+  }
+
+  bool success = true;
+  // Only zero-byte files matching our exact marker pattern are removed.
+  for (uint8_t pass = 0; pass < 16; ++pass) {
+    String oldMarker;
+    ESP_SDFile root = ESP_SD::open("/", ESP_FILE_READ);
+    if (!root.isOpen()) {
+      success = false;
+      break;
+    }
+    ESP_SDFile entry = root.openNextFile();
+    while (entry) {
+      const String name = entry.name();
+      if (!entry.isDirectory() && entry.size() == 0 &&
+          name != marker && name != passwordMarker &&
+          fysetcIsManagedMarker(name)) {
+        oldMarker = name;
+        entry.close();
+        break;
+      }
+      entry.close();
+      entry = root.openNextFile();
+    }
+    root.close();
+    if (oldMarker.length() == 0) break;
+    if (!ESP_SD::remove((String("/") + oldMarker).c_str())) {
+      success = false;
+      break;
+    }
+  }
+
+  if (success) success = fysetcEnsureEmptyMarker(marker);
+  if (success) success = fysetcEnsureEmptyMarker(passwordMarker);
+  ESP_SD::releaseFS();
+  if (success) {
+    appliedMarker = marker;
+    appliedPasswordMarker = passwordMarker;
+  } else {
+    nextAttempt = millis() + 5000UL;
+  }
+}
